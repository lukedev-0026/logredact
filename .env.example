# logredact needs no credentials and makes no network requests.
# .env is git-ignored; never commit a real key.

# Key for stable pseudonyms across runs (at least 16 bytes). Generate one with:
#   openssl rand -hex 32
# Anyone holding it can test guesses against pseudonyms, so keep it private and
# never share it together with redacted logs.
# LOGREDACT_KEY=
